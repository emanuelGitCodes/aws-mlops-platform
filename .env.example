# Copy to .env and fill in after deploying. `.env` is gitignored — never commit it.
# Usage: set -a && source .env && set +a

# --- AWS context ---
AWS_PROFILE=default
AWS_REGION=us-east-1
CDK_ENV=dev                      # matches infra/config/<env>.yaml

# --- Stack outputs (from `cdk deploy` / CloudFormation console) ---
# Mlops-Dev-Data outputs / bucket names
RAW_BUCKET=
CURATED_BUCKET=
ARTIFACTS_BUCKET=

# Mlops-Dev-Training output: PipelineRoleArn
PIPELINE_ROLE_ARN=

# --- Pipeline / registry (must match infra/config/<env>.yaml) ---
PIPELINE_NAME=churn-training-pipeline-dev
MODEL_PACKAGE_GROUP=churn-model-group
ENDPOINT_NAME=churn-serverless-dev

# --- Serving (Mlops-Dev-Serving outputs) ---
# ApiUrl output; API key value: aws apigateway get-api-key --api-key <id> --include-value
API_URL=
API_KEY=
