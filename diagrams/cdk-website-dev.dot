digraph "Diagram" {
  splines = "ortho";
  pad = 1;
  nodesep = 0.6;
  ranksep = 0.75;
  fontname = "Sans-Serif";
  fontsize = 15;
  dpi = 200;
  rankdir = "BT";
  compound = true;
  fontcolor = "#222222";
  edge [
    color = "#D5871488";
    penwidth = 2;
    arrowhead = "dot";
    arrowtail = "dot";
  ];
  node [
    shape = "box";
    style = "rounded";
    fixedsize = true;
    width = 1.7;
    height = 1.7;
    labelloc = "c";
    imagescale = true;
    fontname = "Sans-Serif";
    fontsize = 8;
    margin = 8;
  ];
  subgraph "Mlops-Dev-Website" {
    subgraph "cluster-SubGraph.Mlops-Dev-Website" {
      graph [
        label = "Mlops-Dev-Website";
        labelloc = "b";
        labeljust = "l";
        margin = 10;
        fontsize = 16;
        penwidth = 2;
        pencolor = "#888888";
        style = "filled,rounded";
        fillcolor = "#e4e4e4";
      ];
      "Mlops-Dev-Website/WebsiteVpc" [
        label = " WebsiteVpc";
        fontsize = 12;
        image = "cdk-dia-icons/aws/Service/Arch_Networking-Content/64/Arch_Amazon-Virtual-Private-Cloud_64@5x.png";
        imagescale = "true";
        imagepos = "tc";
        penwidth = 0;
        shape = "node";
        fixedsize = "true";
        labelloc = "b";
        width = 2;
        height = 2.266;
      ];
      "Mlops-Dev-Website/WebsiteFlowLogs" [
        label = " WebsiteFlowLogs";
        fontsize = 12;
        image = "cdk-dia-icons/aws/Resource/Res_Management-Governance/Res_48_Dark/Res_Amazon-Cloudwatch_Logs_48_Dark_gen.png";
        imagescale = "true";
        imagepos = "tc";
        penwidth = 0;
        shape = "node";
        fixedsize = "true";
        labelloc = "b";
        width = 2;
        height = 2.266;
      ];
      "Mlops-Dev-Website/WebsiteSecurityGroup" [
        label = " WebsiteSecurityGroup";
        fontsize = 12;
        image = "cdk-dia-icons/aws/security_group.png";
        imagescale = "true";
        imagepos = "tc";
        penwidth = 0;
        shape = "node";
        fixedsize = "true";
        labelloc = "b";
        width = 2;
        height = 2.266;
      ];
      "Mlops-Dev-Website/MailingListTable" [
        label = " MailingListTable";
        fontsize = 12;
        image = "cdk-dia-icons/aws/Service/Arch_Database/64/Arch_Amazon-DynamoDB_64@5x.png";
        imagescale = "true";
        imagepos = "tc";
        penwidth = 0;
        shape = "node";
        fixedsize = "true";
        labelloc = "b";
        width = 1.2;
        height = 1.466;
      ];
      "Mlops-Dev-Website/WebsiteInstanceRole" [
        label = " WebsiteInstanceRole";
        fontsize = 12;
        image = "cdk-dia-icons/aws/Service/Arch_Security-Identity-Compliance/64/Arch_AWS-Identity-and-Access-Management_64@5x.png";
        imagescale = "true";
        imagepos = "tc";
        penwidth = 0;
        shape = "node";
        fixedsize = "true";
        labelloc = "b";
        width = 1.2;
        height = 1.466;
      ];
      "Mlops-Dev-Website/WebsiteInstance" [
        label = " WebsiteInstance";
        fontsize = 12;
        image = "cdk-dia-icons/aws/Resource/Res_Compute/Res_48_Dark/Res_Amazon-EC2_T4g-Instance_48_Dark.png";
        imagescale = "true";
        imagepos = "tc";
        penwidth = 0;
        shape = "node";
        fixedsize = "true";
        labelloc = "b";
        width = 2;
        height = 2.266;
      ];
      "Mlops-Dev-Website/WebsiteEip" [
        label = " EC2 EIP WebsiteEip";
        fontsize = 12;
      ];
      "Mlops-Dev-Website/WebsiteDistribution" [
        label = " WebsiteDistribution";
        fontsize = 12;
        image = "cdk-dia-icons/aws/Service/Arch_Networking-Content/64/Arch_Amazon-CloudFront_64@5x.png";
        imagescale = "true";
        imagepos = "tc";
        penwidth = 0;
        shape = "node";
        fixedsize = "true";
        labelloc = "b";
        width = 2;
        height = 2.266;
      ];
    }
  }
  "Mlops-Dev-Website/WebsiteVpc" -> "Mlops-Dev-Website/WebsiteFlowLogs" [
    dir = "both";
  ];
  "Mlops-Dev-Website/WebsiteSecurityGroup" -> "Mlops-Dev-Website/WebsiteVpc" [
    dir = "both";
  ];
  "Mlops-Dev-Website/WebsiteInstanceRole" -> "Mlops-Dev-Website/MailingListTable" [
    dir = "both";
  ];
  "Mlops-Dev-Website/WebsiteInstance" -> "Mlops-Dev-Website/WebsiteInstanceRole" [
    dir = "both";
  ];
  "Mlops-Dev-Website/WebsiteInstance" -> "Mlops-Dev-Website/WebsiteVpc" [
    dir = "both";
  ];
  "Mlops-Dev-Website/WebsiteInstance" -> "Mlops-Dev-Website/WebsiteSecurityGroup" [
    dir = "both";
  ];
  "Mlops-Dev-Website/WebsiteInstance" -> "Mlops-Dev-Website/MailingListTable" [
    dir = "both";
  ];
  "Mlops-Dev-Website/WebsiteDistribution" -> "Mlops-Dev-Website/WebsiteEip" [
    dir = "both";
  ];
}