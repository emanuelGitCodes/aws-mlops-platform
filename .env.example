# Copy this file to `.env` after deployment. Fill each required value.
# Do not commit `.env`.
# Usage: set -a && source .env && set +a

# --- AWS context ---
AWS_ACCOUNT_ID=
AWS_PROFILE=default
AWS_REGION=us-east-1
# Match `infra/config/<env>.yaml`.
CDK_ENV=dev

# --- Stack outputs (from `cdk deploy` / CloudFormation console) ---
# Mlops-Dev-Data outputs. These are bucket names.
RAW_BUCKET=
CURATED_BUCKET=
ARTIFACTS_BUCKET=

# Mlops-Dev-Security output: AccessLogBucketName.
# For the budget name, run `aws budgets describe-budgets`.
ACCESS_LOG_BUCKET=
AUDIT_BUCKET=
MONTHLY_BUDGET_NAME=
# For AUDIT_KEY_ID, the key behind alias/mlops-dev-audit, run:
#     aws kms describe-key --key-id alias/mlops-dev-audit
AUDIT_KEY_ID=

# Mlops-Dev-Training output: PipelineRoleArn
PIPELINE_ROLE_ARN=

# --- Pipeline / registry (must match infra/config/<env>.yaml) ---
PIPELINE_NAME=churn-training-pipeline-dev
MODEL_PACKAGE_GROUP=churn-model-group
ENDPOINT_NAME=churn-serverless-dev

# --- Serving (Mlops-Dev-Serving outputs) ---
# Set `API_URL` to the `ApiUrl` stack output.
# Callers sign requests with the AWS profile and need `execute-api:Invoke`.
API_URL=

# --- AWS IAM user ---
MLOPS_DEPLOYER_USER_NAME=
AWS_ADMIN_USER_NAME=
AWS_SECURITY_AUDITOR_USER_NAME=
GITHUB_DEPLOY_ROLE_NAME=

# --- AWS API Gateway ---
# API_GATEWAY_ID is the REST API id, the subdomain of the ApiUrl host.
API_GATEWAY_ID=
